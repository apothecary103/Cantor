{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "A song: tempo, meter, sections, an optional reference recording and\nsinging tracks.",
  "type": "object",
  "properties": {
    "format": {
      "description": "File format version; always 3.",
      "type": "integer",
      "format": "uint32",
      "default": 3,
      "minimum": 0
    },
    "key": {
      "description": "The song's key, for highlighting and snapping. `null` = none.",
      "anyOf": [
        {
          "$ref": "#/$defs/Key"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "description": "Title, artist and comment.",
      "$ref": "#/$defs/Meta",
      "default": {
        "artist": "",
        "comment": "",
        "title": ""
      }
    },
    "reference": {
      "description": "The original song's vocal or mix, for A/B listening, pitch matching\nand render reports.",
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "sections": {
      "description": "Named sections (verse, chorus, ...), sorted by start.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "tempo": {
      "description": "Tempo changes, sorted by tick; the first is at tick 0.",
      "type": "array",
      "default": [
        {
          "bpm": 120.0,
          "tick": 0
        }
      ],
      "items": {
        "$ref": "#/$defs/TempoPoint"
      }
    },
    "time_sig": {
      "description": "Time-signature changes, sorted by bar; the first is at bar 0.",
      "type": "array",
      "default": [
        {
          "bar": 0,
          "den": 4,
          "num": 4
        }
      ],
      "items": {
        "$ref": "#/$defs/TimeSigPoint"
      }
    },
    "tracks": {
      "description": "Singing tracks, in display order.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Track"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Bend": {
      "description": "A bend at a note's start (scoop) or end (fall).",
      "type": "object",
      "properties": {
        "cents": {
          "description": "Pitch offset at the far end of the bend, in cents, -1200..=1200.",
          "type": "number",
          "format": "double"
        },
        "length_ms": {
          "description": "Duration in ms, 0..=2000.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "cents",
        "length_ms"
      ]
    },
    "Curve": {
      "description": "A track expression curve: points interpolated over ticks.",
      "type": "object",
      "properties": {
        "interp": {
          "description": "How values between points are interpolated.",
          "$ref": "#/$defs/Interp",
          "default": "linear"
        },
        "points": {
          "description": "`[tick, value]` pairs sorted by tick with unique ticks. Before the\nfirst and after the last point the nearest value holds.",
          "type": "array",
          "default": [],
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "number",
                "format": "double"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "EffectKind": {
      "description": "Built-in effects.",
      "oneOf": [
        {
          "description": "Parametric equalizer.",
          "type": "string",
          "const": "eq"
        },
        {
          "description": "Dynamic range compressor.",
          "type": "string",
          "const": "compressor"
        },
        {
          "description": "Sibilance reducer.",
          "type": "string",
          "const": "de_esser"
        },
        {
          "description": "Room reverb.",
          "type": "string",
          "const": "reverb"
        },
        {
          "description": "Feedback echo.",
          "type": "string",
          "const": "delay"
        }
      ]
    },
    "EffectSlot": {
      "description": "One effect in a track's chain.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Bypassed when false.",
          "type": "boolean",
          "default": true
        },
        "kind": {
          "description": "Which effect.",
          "$ref": "#/$defs/EffectKind"
        },
        "params": {
          "description": "Parameters by id (see the effect registry); omitted ones take their\ndefaults.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "Interp": {
      "description": "Interpolation between curve points.",
      "oneOf": [
        {
          "description": "Straight lines.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Hold each value until the next point.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "Monotone cubic: smooth and never overshoots the points.",
          "type": "string",
          "const": "smooth"
        }
      ]
    },
    "Key": {
      "description": "A musical key.",
      "type": "object",
      "properties": {
        "scale": {
          "description": "The scale.",
          "$ref": "#/$defs/Scale",
          "default": "major"
        },
        "tonic": {
          "description": "Pitch class of the tonic, 0 (C) ..= 11 (B).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "tonic"
      ]
    },
    "Meta": {
      "description": "Free-form project information.",
      "type": "object",
      "properties": {
        "artist": {
          "description": "Original artist.",
          "type": "string",
          "default": ""
        },
        "comment": {
          "description": "Notes about the project.",
          "type": "string",
          "default": ""
        },
        "title": {
          "description": "Song title.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Mix": {
      "description": "Track gain, pan, mute and solo.",
      "type": "object",
      "properties": {
        "gain_db": {
          "description": "Gain in dB, -60..=12.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "mute": {
          "description": "Silences the track.",
          "type": "boolean"
        },
        "pan": {
          "description": "Pan, -1 (left) ..= 1 (right).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "solo": {
          "description": "When any track is soloed, only soloed tracks play.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Note": {
      "description": "A note: a lyric sung at a pitch for a span of ticks.",
      "type": "object",
      "properties": {
        "alias": {
          "description": "Forces this exact oto.ini alias; omitted = the phonemizer decides.",
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "description": "Resampler flags appended to the track's flags.",
          "type": "string"
        },
        "id": {
          "description": "Unique id within the project. Omit (or 0) in `add_notes` to have one\nassigned.",
          "$ref": "#/$defs/NoteId",
          "default": 0
        },
        "key": {
          "description": "MIDI note number, 0..=127 (60 = C4).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "length": {
          "description": "Length in ticks, > 0.",
          "type": "integer",
          "format": "int64"
        },
        "lyric": {
          "description": "What is sung: \"あ\", \"ka\", \"+\" (extend the previous note), \"-\" (rest\nwith breath release), \"br\" (breath).",
          "type": "string"
        },
        "mod": {
          "description": "Modulation: % of the sample's own pitch wobble kept, 0..=100.",
          "type": "number",
          "format": "double"
        },
        "pitch": {
          "description": "Portamento, scoop, fall, vibrato and extra bend points.",
          "$ref": "#/$defs/NotePitch",
          "default": {
            "portamento": {
              "length_ms": 80.0,
              "overshoot_cents": 0.0,
              "preparation_cents": 0.0,
              "shape": "s",
              "start_ms": -40.0
            }
          }
        },
        "start": {
          "description": "Start in absolute ticks (480 per quarter note), >= 0.",
          "type": "integer",
          "format": "int64"
        },
        "timing": {
          "description": "Overrides of the oto.ini timing.",
          "$ref": "#/$defs/Timing"
        },
        "vel": {
          "description": "Consonant velocity in %, 0..=200; above 100 shortens the consonant.",
          "type": "number",
          "format": "double",
          "default": 100.0
        },
        "vol": {
          "description": "Intensity (volume) in %, 0..=200.",
          "type": "number",
          "format": "double",
          "default": 100.0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "length",
        "key",
        "lyric"
      ]
    },
    "NoteId": {
      "description": "Identifies a note, unique within the project. `0` (or omitted) in\n`add_notes` means \"assign one\".",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "NotePitch": {
      "description": "A note's pitch expression. The final pitch at time t is\n`key·100 + portamento + scoop + fall + vibrato + points + pitd(t)` cents.",
      "type": "object",
      "properties": {
        "fall": {
          "description": "Bend away at the note's end (cents < 0 drops).",
          "anyOf": [
            {
              "$ref": "#/$defs/Bend"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "description": "Extra bend points relative to the note start, interpolated smoothly.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PitchPoint"
          }
        },
        "portamento": {
          "description": "The glide from the previous note's pitch into this one.",
          "$ref": "#/$defs/Portamento",
          "default": {
            "length_ms": 80.0,
            "overshoot_cents": 0.0,
            "preparation_cents": 0.0,
            "shape": "s",
            "start_ms": -40.0
          }
        },
        "scoop": {
          "description": "Start below (cents < 0) or above the pitch and bend in.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bend"
            },
            {
              "type": "null"
            }
          ]
        },
        "vibrato": {
          "description": "Vibrato near the note's end.",
          "anyOf": [
            {
              "$ref": "#/$defs/Vibrato"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Phonemizer": {
      "description": "How lyrics become oto.ini aliases.",
      "oneOf": [
        {
          "description": "Pick from the voicebank's aliases (CV, VCV or CVVC).",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Japanese CV: one alias per kana (\"あ\", \"か\").",
          "type": "string",
          "const": "jp_cv"
        },
        {
          "description": "Japanese VCV: \"a か\" style aliases, previous vowel first.",
          "type": "string",
          "const": "jp_vcv"
        },
        {
          "description": "Japanese CVVC: CV aliases plus \"a k\" vowel-consonant links.",
          "type": "string",
          "const": "jp_cvvc"
        },
        {
          "description": "English ARPAsing (arpabet aliases).",
          "type": "string",
          "const": "en_arpasing"
        },
        {
          "description": "The lyric is the alias, unchanged.",
          "type": "string",
          "const": "raw"
        }
      ]
    },
    "PitchPoint": {
      "description": "An extra pitch-bend point within a note.",
      "type": "object",
      "properties": {
        "cents": {
          "description": "Pitch offset in cents, -1200..=1200.",
          "type": "number",
          "format": "double"
        },
        "ms": {
          "description": "Time relative to the note start, in ms.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "ms",
        "cents"
      ]
    },
    "Portamento": {
      "description": "The transition from the previous note's pitch into this note.",
      "type": "object",
      "properties": {
        "length_ms": {
          "description": "Glide duration in ms, 0..=1000; 0 = hard step.",
          "type": "number",
          "format": "double",
          "default": 80.0
        },
        "overshoot_cents": {
          "description": "How far past the target the glide goes before settling, in cents,\n0..=200.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "preparation_cents": {
          "description": "Dip opposite to the jump before the glide, in cents, 0..=200.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "shape": {
          "description": "Easing of the glide.",
          "$ref": "#/$defs/Shape",
          "default": "s"
        },
        "start_ms": {
          "description": "Where the glide starts relative to the note start, in ms,\n-1000..=1000; negative starts before the note.",
          "type": "number",
          "format": "double",
          "default": -40.0
        }
      },
      "additionalProperties": false
    },
    "Reference": {
      "description": "The original recording a cover is made from.",
      "type": "object",
      "properties": {
        "gain_db": {
          "description": "Playback gain in dB, -60..=12.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "muted": {
          "description": "Whether playback of the reference is muted.",
          "type": "boolean",
          "default": false
        },
        "offset_ms": {
          "description": "Time in the audio file, in ms, that lines up with tick 0.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "path": {
          "description": "Audio file, relative to the project file (or absolute).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "Scale": {
      "description": "Scales for key highlighting and snapping.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "major",
            "harmonic_minor",
            "dorian",
            "minor_pentatonic"
          ]
        },
        {
          "description": "Natural minor.",
          "type": "string",
          "const": "minor"
        },
        {
          "description": "Major pentatonic.",
          "type": "string",
          "const": "pentatonic"
        }
      ]
    },
    "Section": {
      "description": "A named span of the song.",
      "type": "object",
      "properties": {
        "end": {
          "description": "Tick after the last; greater than `start`.",
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "description": "Name, such as \"verse 1\" or \"chorus\".",
          "type": "string"
        },
        "start": {
          "description": "First tick.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "start",
        "end"
      ]
    },
    "Shape": {
      "description": "Easing of a glide.",
      "oneOf": [
        {
          "description": "Ease in and out.",
          "type": "string",
          "const": "s"
        },
        {
          "description": "Constant speed.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Slow start, fast end.",
          "type": "string",
          "const": "in"
        },
        {
          "description": "Fast start, slow end.",
          "type": "string",
          "const": "out"
        }
      ]
    },
    "TempoPoint": {
      "description": "A tempo change.",
      "type": "object",
      "properties": {
        "bpm": {
          "description": "Quarter notes per minute, 10..=1000.",
          "type": "number",
          "format": "double"
        },
        "tick": {
          "description": "Where the tempo starts, in ticks (480 per quarter note).",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "bpm"
      ]
    },
    "TimeSigPoint": {
      "description": "A time-signature change.",
      "type": "object",
      "properties": {
        "bar": {
          "description": "The 0-based bar where the signature starts.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "den": {
          "description": "Beat unit: 1, 2, 4, 8, 16 or 32.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "num": {
          "description": "Beats per bar, 1..=32.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "bar",
        "num",
        "den"
      ]
    },
    "Timing": {
      "description": "Per-note overrides of oto.ini timing.",
      "type": "object",
      "properties": {
        "offset_ms": {
          "description": "Extra start offset into the sample in ms.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "overlap_ms": {
          "description": "Overlap with the previous note in ms; omitted = the oto value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "preutter_ms": {
          "description": "Pre-utterance in ms (how early the sample starts before the note);\nomitted = the alias's oto value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Track": {
      "description": "A singing track: one voicebank singing a monophonic line.",
      "type": "object",
      "properties": {
        "curves": {
          "description": "Expression curves by parameter id (pitd, dyn, gen, bre, bri, tone).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Curve"
          }
        },
        "effects": {
          "description": "Post-processing chain, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectSlot"
          }
        },
        "flags": {
          "description": "Default resampler flags for every note, such as \"g-5B40\".",
          "type": "string"
        },
        "id": {
          "description": "Unique id. Omit (or 0) in `add_track` to have one assigned.",
          "$ref": "#/$defs/TrackId",
          "default": 0
        },
        "mix": {
          "description": "Gain, pan, mute and solo.",
          "$ref": "#/$defs/Mix",
          "default": {
            "gain_db": 0.0,
            "pan": 0.0
          }
        },
        "name": {
          "description": "Display name.",
          "type": "string",
          "default": ""
        },
        "notes": {
          "description": "Notes sorted by (start, id), in absolute ticks; they never overlap.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "phonemizer": {
          "description": "How lyrics become aliases.",
          "$ref": "#/$defs/Phonemizer",
          "default": "auto"
        },
        "singer": {
          "description": "Voicebank id, as listed by `list_voicebanks`. Empty = no singer.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "TrackId": {
      "description": "Identifies a track. `0` (or omitted) in `add_track` means \"assign one\".",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Vibrato": {
      "description": "Vibrato over the end portion of a note.",
      "type": "object",
      "properties": {
        "depth_cents": {
          "description": "Depth in cents (half peak-to-peak), 0..=200.",
          "type": "number",
          "format": "double",
          "default": 20.0
        },
        "drift": {
          "description": "Slow random wander of rate and depth, 0..=1, seeded by the note id.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "fade_in": {
          "description": "Fade-in as % of the vibrato length, 0..=100.",
          "type": "number",
          "format": "double",
          "default": 30.0
        },
        "fade_out": {
          "description": "Fade-out as % of the vibrato length, 0..=100.",
          "type": "number",
          "format": "double",
          "default": 20.0
        },
        "length": {
          "description": "% of the note, from its end, that vibrates, 0..=100.",
          "type": "number",
          "format": "double",
          "default": 65.0
        },
        "period_ms": {
          "description": "Period in ms (1000 / rate in Hz), 50..=1000; 150..220 is typical.",
          "type": "number",
          "format": "double",
          "default": 175.0
        },
        "phase": {
          "description": "Starting phase as a fraction of a cycle, 0..=1.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "shift": {
          "description": "Center offset as % of depth, -100..=100.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
