{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "A Cantor project.",
  "type": "object",
  "properties": {
    "key_map": {
      "description": "Key changes, sorted by tick. Drives scale highlighting and snapping.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/KeyPoint"
      }
    },
    "meta": {
      "description": "Title and credits.",
      "$ref": "#/$defs/Meta",
      "default": {
        "artist": "",
        "comment": "",
        "title": ""
      }
    },
    "sections": {
      "description": "Named song sections (verse, chorus, ...), sorted by start.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "seeds": {
      "description": "Diffusion noise seed per phrase.",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^\\d+$": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "takes": {
      "description": "Retakes per phrase. Takes are kept, not discarded.",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/TakeLane"
        }
      }
    },
    "tempo_map": {
      "description": "Tempo changes, sorted by tick; the first is at tick 0.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TempoPoint"
      }
    },
    "time_sig_map": {
      "description": "Time-signature changes, sorted by bar; the first is at bar 0.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimeSigPoint"
      }
    },
    "tracks": {
      "description": "Tracks in display order.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Track"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tempo_map",
    "time_sig_map"
  ],
  "$defs": {
    "BackendRef": {
      "description": "Names a synthesis backend, such as `\"diffsinger\"` or `\"utau\"`.",
      "type": "string"
    },
    "Curve": {
      "description": "A curve: control points with an interpolation mode.",
      "type": "object",
      "properties": {
        "interp": {
          "description": "How values between points are interpolated.",
          "$ref": "#/$defs/Interp",
          "default": "monotone_hermite"
        },
        "points": {
          "description": "`(tick, value)` points with strictly increasing ticks.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "number",
                "format": "double"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "points"
      ]
    },
    "Doubling": {
      "description": "Voice doubling: extra layers with seeded micro-variations.",
      "type": "object",
      "properties": {
        "detune_cents": {
          "description": "Pitch variation between layers in cents.",
          "type": "number",
          "format": "double",
          "default": 8.0
        },
        "jitter_ms": {
          "description": "Timing variation between layers in milliseconds.",
          "type": "number",
          "format": "double",
          "default": 12.0
        },
        "layers": {
          "description": "Number of voices, 1 (off) … 16.",
          "type": "integer",
          "format": "uint8",
          "default": 1,
          "maximum": 255,
          "minimum": 0
        },
        "seed": {
          "description": "Seed for the variations.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "spacing": {
          "description": "Stereo spread, 0 … 1.",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "timbre": {
          "description": "Timbre (formant) variation between layers, 0 … 1.",
          "type": "number",
          "format": "double",
          "default": 0.5
        }
      },
      "additionalProperties": false
    },
    "EffectKind": {
      "description": "Built-in effects.",
      "type": "string",
      "enum": [
        "eq",
        "compressor",
        "de_esser",
        "reverb"
      ]
    },
    "EffectSlot": {
      "description": "One effect in a track's chain.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Bypassed when false.",
          "type": "boolean"
        },
        "kind": {
          "description": "Which effect.",
          "$ref": "#/$defs/EffectKind"
        },
        "params": {
          "description": "Effect parameters by name.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "enabled"
      ]
    },
    "Envelope": {
      "description": "Attack or release shaping.",
      "type": "object",
      "properties": {
        "length_ms": {
          "description": "Length in milliseconds.",
          "type": "number",
          "format": "double"
        },
        "strength": {
          "description": "Strength, 0 … 1.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "length_ms",
        "strength"
      ]
    },
    "Interp": {
      "description": "Interpolation between curve points.",
      "oneOf": [
        {
          "description": "Hold each value until the next point.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "Straight lines.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Fritsch–Carlson monotone cubic; never overshoots.",
          "type": "string",
          "const": "monotone_hermite"
        }
      ]
    },
    "KeyPoint": {
      "description": "A key change.",
      "type": "object",
      "properties": {
        "scale": {
          "description": "Scale or mode.",
          "$ref": "#/$defs/Scale"
        },
        "tick": {
          "description": "Where the key takes effect.",
          "type": "integer",
          "format": "int64"
        },
        "tonic": {
          "description": "Tonic pitch class, 0 = C … 11 = B.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "tonic",
        "scale"
      ]
    },
    "LangTag": {
      "description": "A BCP 47 language tag, such as `\"ja\"` or `\"en-US\"`.",
      "type": "string"
    },
    "LayeredCurve": {
      "description": "A layered parameter: `final = base(notes) + model_prediction + user_delta`.\nUsers and agents edit `user_delta`; the backend writes `model_prediction`.",
      "type": "object",
      "properties": {
        "model_prediction": {
          "description": "Produced by the backend; retakeable.",
          "$ref": "#/$defs/Curve",
          "default": {
            "interp": "monotone_hermite",
            "points": []
          }
        },
        "user_delta": {
          "description": "Edited by users and agents.",
          "$ref": "#/$defs/Curve",
          "default": {
            "interp": "monotone_hermite",
            "points": []
          }
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "description": "Title and credits.",
      "type": "object",
      "properties": {
        "artist": {
          "description": "Artist or author.",
          "type": "string",
          "default": ""
        },
        "comment": {
          "description": "Free-form notes.",
          "type": "string",
          "default": ""
        },
        "title": {
          "description": "Song title.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Mix": {
      "description": "Track mixer settings.",
      "type": "object",
      "properties": {
        "gain_db": {
          "description": "Gain in dB.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "mute": {
          "description": "Muted.",
          "type": "boolean",
          "default": false
        },
        "pan": {
          "description": "Pan, -1 (left) … 1 (right).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "solo": {
          "description": "Soloed.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Note": {
      "description": "A sung note.",
      "type": "object",
      "properties": {
        "expr": {
          "description": "Vibrato, portamento, attack and release.",
          "$ref": "#/$defs/NoteExpr",
          "default": {
            "portamento": {
              "before": 0.6,
              "overshoot_cents": 0.0,
              "preparation_cents": 0.0
            }
          }
        },
        "id": {
          "description": "Unique id.",
          "$ref": "#/$defs/NoteId"
        },
        "lang": {
          "description": "Language override; `None` uses the singer's default language.",
          "anyOf": [
            {
              "$ref": "#/$defs/LangTag"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "description": "Length in ticks, at least 1.",
          "type": "integer",
          "format": "int64"
        },
        "lyric": {
          "description": "Lyric text. `+` continues the previous syllable; a leading or\ntrailing `-` joins syllables of one word.",
          "type": "string"
        },
        "modes": {
          "description": "Vocal mode weights.",
          "$ref": "#/$defs/VocalModes",
          "default": {
            "pitch": {},
            "pronunciation": {},
            "timbre": {}
          }
        },
        "phonemes": {
          "description": "Phoneme overrides; `None` lets the phonemizer decide.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/PhonemeOverride"
          }
        },
        "pitch_cents": {
          "description": "Pitch in cents, MIDI note number × 100. Microtonal by default.",
          "type": "number",
          "format": "double"
        },
        "start": {
          "description": "Start tick relative to the part.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "length",
        "pitch_cents",
        "lyric"
      ]
    },
    "NoteExpr": {
      "description": "Note expression.",
      "type": "object",
      "properties": {
        "attack": {
          "description": "Onset shaping, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "portamento": {
          "description": "Transition into this note.",
          "$ref": "#/$defs/Portamento",
          "default": {
            "before": 0.6,
            "overshoot_cents": 0.0,
            "preparation_cents": 0.0
          }
        },
        "release": {
          "description": "Release shaping, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "vibrato": {
          "description": "Procedural vibrato, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Vibrato"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "NoteId": {
      "description": "Identifies a note.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Part": {
      "description": "A region of notes on a track. Note positions are relative to `start`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id.",
          "$ref": "#/$defs/PartId"
        },
        "length": {
          "description": "Length in ticks.",
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "notes": {
          "description": "Notes, sorted by (start, id).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "start": {
          "description": "Absolute start tick.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start",
        "length"
      ]
    },
    "PartId": {
      "description": "Identifies a part (a region of notes on a track).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "PhonemeAlphabet": {
      "description": "Which symbol set a phoneme uses.",
      "oneOf": [
        {
          "description": "The phonemizer's own symbols.",
          "type": "string",
          "const": "native"
        },
        {
          "description": "Universal X-SAMPA.",
          "type": "string",
          "const": "x_sampa"
        }
      ]
    },
    "PhonemeOverride": {
      "description": "A user-specified phoneme.",
      "type": "object",
      "properties": {
        "alphabet": {
          "description": "Symbol alphabet.",
          "$ref": "#/$defs/PhonemeAlphabet",
          "default": "native"
        },
        "length_ms": {
          "description": "Pinned length in milliseconds; `None` lets the duration model decide.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "offset_ms": {
          "description": "Onset relative to the note onset in milliseconds; `None` = automatic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "symbol": {
          "description": "Phoneme symbol.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "symbol"
      ]
    },
    "Portamento": {
      "description": "Portamento into a note: a cosine-eased transition from the previous pitch.",
      "type": "object",
      "properties": {
        "before": {
          "description": "Fraction of the transition before the note boundary, 0 … 1.",
          "type": "number",
          "format": "double",
          "default": 0.6
        },
        "length_ms": {
          "description": "Transition length in milliseconds; `None` = automatic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "overshoot_cents": {
          "description": "Overshoot past the target pitch in cents.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "preparation_cents": {
          "description": "Dip opposite to the transition direction before it starts, in cents.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "RetakeDim": {
      "description": "A dimension a retake can vary.",
      "type": "string",
      "enum": [
        "pitch",
        "timing",
        "timbre",
        "expression"
      ]
    },
    "Scale": {
      "description": "A scale or mode for key signatures.",
      "type": "string",
      "enum": [
        "major",
        "minor",
        "dorian",
        "phrygian",
        "lydian",
        "mixolydian",
        "locrian",
        "chromatic"
      ]
    },
    "Section": {
      "description": "A named region of the song, such as a verse or chorus.",
      "type": "object",
      "properties": {
        "end": {
          "description": "First tick after the section.",
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "description": "Unique name.",
          "type": "string"
        },
        "start": {
          "description": "First tick.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "start",
        "end"
      ]
    },
    "SingerRef": {
      "description": "Names a singer (voicebank).",
      "type": "object",
      "properties": {
        "id": {
          "description": "Singer identifier; empty means none selected.",
          "type": "string"
        },
        "version": {
          "description": "Singer version, if pinned.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Take": {
      "description": "One retake of a phrase.",
      "type": "object",
      "properties": {
        "dims": {
          "description": "Which dimensions were re-generated.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetakeDim"
          }
        },
        "id": {
          "description": "Unique within the lane.",
          "$ref": "#/$defs/TakeId"
        },
        "label": {
          "description": "Display label.",
          "type": "string",
          "default": ""
        },
        "seed": {
          "description": "Seed used to generate the take.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "seed",
        "dims"
      ]
    },
    "TakeId": {
      "description": "Identifies a take within a phrase's take lane.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "TakeLane": {
      "description": "All takes of one phrase.",
      "type": "object",
      "properties": {
        "selected": {
          "description": "The take that plays; `None` = the original.",
          "anyOf": [
            {
              "$ref": "#/$defs/TakeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "takes": {
          "description": "Every take, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Take"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "takes"
      ]
    },
    "TempoPoint": {
      "description": "A tempo change.",
      "type": "object",
      "properties": {
        "bpm": {
          "description": "Quarter notes per minute.",
          "type": "number",
          "format": "double"
        },
        "tick": {
          "description": "Where the tempo takes effect.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "bpm"
      ]
    },
    "TimeSigPoint": {
      "description": "A time-signature change, at the start of a bar.",
      "type": "object",
      "properties": {
        "bar": {
          "description": "0-based bar where the signature takes effect.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "denominator": {
          "description": "Beat unit, a power of two.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "numerator": {
          "description": "Beats per bar.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "bar",
        "numerator",
        "denominator"
      ]
    },
    "Track": {
      "description": "A singing track.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "The synthesis backend.",
          "$ref": "#/$defs/BackendRef"
        },
        "curves": {
          "description": "Layered parameter curves, in absolute ticks.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LayeredCurve"
          },
          "default": {}
        },
        "doubling": {
          "description": "Voice doubling.",
          "$ref": "#/$defs/Doubling",
          "default": {
            "detune_cents": 8.0,
            "jitter_ms": 12.0,
            "layers": 1,
            "seed": 0,
            "spacing": 0.5,
            "timbre": 0.5
          }
        },
        "effects": {
          "description": "Post-processing chain, in order.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EffectSlot"
          }
        },
        "id": {
          "description": "Unique id.",
          "$ref": "#/$defs/TrackId"
        },
        "mix": {
          "description": "Gain, pan, mute and solo.",
          "$ref": "#/$defs/Mix",
          "default": {
            "gain_db": 0.0,
            "mute": false,
            "pan": 0.0,
            "solo": false
          }
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "parts": {
          "description": "Parts, sorted by (start, id).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "singer": {
          "description": "The voice that sings this track.",
          "$ref": "#/$defs/SingerRef"
        },
        "voice_mix": {
          "description": "Timbre blending with other singers, if the backend supports it.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/VoiceMixEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "singer",
        "backend"
      ]
    },
    "TrackId": {
      "description": "Identifies a track.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Vibrato": {
      "description": "Procedural vibrato: `v(t) = D · env(t) · sin(2π ∫ f(τ)dτ + φ)`.",
      "type": "object",
      "properties": {
        "depth_cents": {
          "description": "Depth D in cents.",
          "type": "number",
          "format": "double"
        },
        "drift": {
          "description": "Random rate drift, 0 … 1 (1 ≈ ±5%).",
          "type": "number",
          "format": "double"
        },
        "fade_in": {
          "description": "Fade-in length as a fraction of the vibrato, 0 … 1.",
          "type": "number",
          "format": "double"
        },
        "fade_out": {
          "description": "Fade-out length as a fraction of the vibrato, 0 … 1.",
          "type": "number",
          "format": "double"
        },
        "phase": {
          "description": "Initial phase φ as a fraction of a cycle, 0 … 1.",
          "type": "number",
          "format": "double"
        },
        "rate_hz": {
          "description": "Rate in Hz.",
          "type": "number",
          "format": "double"
        },
        "start": {
          "description": "Where vibrato starts, as a fraction of the note, 0 … 1.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "depth_cents",
        "rate_hz",
        "start",
        "fade_in",
        "fade_out",
        "phase",
        "drift"
      ]
    },
    "VocalModes": {
      "description": "Vocal mode weights per dimension (SynthV-style pitch / timbre /\npronunciation modes). Mode names come from the singer.",
      "type": "object",
      "properties": {
        "pitch": {
          "description": "Pitch-mode weights by mode name.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        },
        "pronunciation": {
          "description": "Pronunciation-mode weights by mode name.",
