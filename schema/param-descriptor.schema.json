{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParamDescriptor",
  "description": "Describes one parameter: a track curve or a numeric note field.",
  "type": "object",
  "properties": {
    "default": {
      "description": "Value when nothing is set.",
      "type": "number",
      "format": "double"
    },
    "description": {
      "description": "What the parameter controls.",
      "type": "string"
    },
    "id": {
      "description": "Stable identifier: the curve id, or the note field path such as\n`\"portamento.length_ms\"` (fields of `Note`, `Timing` and `NotePitch`).",
      "type": "string"
    },
    "max": {
      "description": "Largest allowed value.",
      "type": "number",
      "format": "double"
    },
    "min": {
      "description": "Smallest allowed value.",
      "type": "number",
      "format": "double"
    },
    "name": {
      "description": "Human-readable name.",
      "type": "string"
    },
    "unit": {
      "description": "Unit of the value.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "unit",
    "min",
    "max",
    "default",
    "description"
  ]
}
