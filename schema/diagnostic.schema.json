{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic",
  "description": "A message about an edit or a project.",
  "type": "object",
  "properties": {
    "code": {
      "description": "Stable machine-readable code, such as `\"note.not_found\"`.",
      "type": "string"
    },
    "entity": {
      "description": "What it is about, if anything specific.",
      "anyOf": [
        {
          "$ref": "#/$defs/Entity"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "description": "Severity.",
      "$ref": "#/$defs/Level"
    },
    "message": {
      "description": "Human-readable explanation.",
      "type": "string"
    }
  },
  "required": [
    "level",
    "code",
    "message"
  ],
  "$defs": {
    "Entity": {
      "description": "What a diagnostic is about.",
      "oneOf": [
        {
          "description": "A track.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The track.",
              "$ref": "#/$defs/TrackId"
            },
            "kind": {
              "type": "string",
              "const": "track"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "A note.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The note.",
              "$ref": "#/$defs/NoteId"
            },
            "kind": {
              "type": "string",
              "const": "note"
            },
            "track": {
              "description": "Its track, when known.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TrackId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "Level": {
      "description": "How serious a diagnostic is.",
      "oneOf": [
        {
          "description": "Background information.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Applied, but something deserves attention.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Rejected; nothing changed.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "NoteId": {
      "description": "Identifies a note, unique within the project. `0` (or omitted) in\n`add_notes` means \"assign one\".",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "TrackId": {
      "description": "Identifies a track. `0` (or omitted) in `add_track` means \"assign one\".",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  }
}
