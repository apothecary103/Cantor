# Rust 
/target/
**/*.rs.bk
# Cargo.lock is committed on purpose (exact pins, reproducible builds).

# Coverage and profiling
*.profraw
*.profdata
lcov.info
/coverage/
perf.data
perf.data.old
flamegraph.svg
*.trace/

# insta: pending snapshots are reviewed, then accepted or deleted
*.snap.new
*.pending-snap

# Nix / direnv 
/.direnv/
result
result-*

# Python (cantor-py, maturin) 
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/crates/cantor-py/python/cantor/*.so
/crates/cantor-py/python/cantor/*.pyd
/dist/wheels/

# WebAssembly plugins 
*.wasm
!crates/cantor-phon/tests/fixtures/**/*.wasm

