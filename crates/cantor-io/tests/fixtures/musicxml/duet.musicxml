      <note>
        <rest/>
        <duration>24</duration><voice>1</voice><type>quarter</type>
      </note>
    </measure>
    <!-- Lyrics without a number attribute count as verse 1. -->
    <measure number="1">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>48</duration><voice>1</voice><type>half</type>
        <lyric><syllabic>begin</syllabic><text>Hal</text></lyric>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>24</duration><voice>1</voice><type>quarter</type>
        <lyric><syllabic>middle</syllabic><text>le</text></lyric>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>24</duration><voice>1</voice><type>quarter</type>
        <lyric><syllabic>end</syllabic><text>lu</text></lyric>
