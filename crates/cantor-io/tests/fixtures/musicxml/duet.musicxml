      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>48</duration><voice>1</voice><type>half</type>
        <lyric number="1"><syllabic>single</syllabic><text>now</text></lyric>
        <lyric number="2"><syllabic>single</syllabic><text>then</text></lyric>
      </note>
    </measure>
    <measure number="3">
      <attributes><divisions>12</divisions></attributes>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>24</duration><voice>1</voice><type>half</type>
        <lyric number="1"><syllabic>begin</syllabic><text>a</text></lyric>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>12</duration><voice>1</voice><type>quarter</type>
        <lyric number="1"><syllabic>end</syllabic><text>men</text></lyric>
      </note>
      <note>
        <rest/>
        <duration>12</duration><voice>1</voice><type>quarter</type>
      </note>
    </measure>
    <measure number="4">
      <attributes>
        <key><fifths>1</fifths><mode>major</mode></key>
        <time><beats>3</beats><beat-type>4</beat-type></time>
      </attributes>
      <sound tempo="72"/>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>36</duration><voice>1</voice><type>half</type><dot/>
        <lyric number="1"><syllabic>single</syllabic><text>home</text></lyric>
      </note>
    </measure>
    <!-- No lyric right after a sung note: a melisma ("+"). -->
    <measure number="5">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>36</duration><voice>1</voice><type>half</type><dot/>
        <notations><fermata type="upright"/></notations>
      </note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
