  - position: 960
    duration: 960
    tone: 64
    lyric: su
    pitch:
      data:
      - {x: -40, y: 0, shape: io}
      - {x: 40, y: 0, shape: io}
      snap_first: true
    vibrato: {length: 60, period: 180, depth: 30, in: 15, out: 20, shift: 25, drift: 0, vol_link: 0}
  - position: 1920
