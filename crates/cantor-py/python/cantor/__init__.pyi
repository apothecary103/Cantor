"""Type stubs for the cantor package."""

from os import PathLike
from types import TracebackType
from typing import Literal, TypedDict

class CantorError(Exception): ...

class _EffectSpecBase(TypedDict):
    kind: Literal["eq", "compressor", "de_esser", "reverb"]

class EffectSpec(_EffectSpecBase, total=False):
    enabled: bool
    params: dict[str, float]

class Project:
    @property
    def id(self) -> str: ...
    @property
    def revision(self) -> int: ...
    @property
    def title(self) -> str: ...
    def track(self, name_or_id: str | int) -> Track: ...
    def tracks(self) -> list[Track]: ...
    def sections(self) -> list[str]: ...
    def transaction(self, label: str) -> Transaction: ...
    def apply_json(self, ops: str) -> None: ...
    def note(self, id: int) -> Note: ...
    def set_tempo(self, tick: int, bpm: float) -> None: ...
    def set_section(self, name: str, start: int, end: int) -> None: ...
    def select_take(self, phrase_id: int, take_id: int | None = None) -> None: ...
    def undo(self) -> bool: ...
    def redo(self) -> bool: ...
    def checkpoint(self, name: str) -> None: ...
    def restore(self, name: str) -> None: ...
    def describe(self) -> str: ...
    def render(
        self,
        quality: Literal["preview", "final"] = "preview",
        start: int | None = None,
        end: int | None = None,
    ) -> Report: ...
    def save(self, path: str | PathLike[str] | None = None) -> str: ...

class Transaction:
    def __enter__(self) -> None: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> bool: ...

class Track:
    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    def notes(self, section: str | None = None) -> list[Note]: ...
    def add_note(self, start: int, length: int, pitch_cents: float, lyric: str = "la") -> Note: ...
    def set_curve(
        self,
        param: str,
        start: int,
        end: int,
        points: list[tuple[int, float]],
        interp: Literal["step", "linear", "hermite"] = "linear",
    ) -> None: ...
    def clear_curve(self, param: str, start: int, end: int) -> None: ...
    def retake(
        self,
        start: int,
        end: int,
        dims: list[Literal["pitch", "timing", "timbre", "expression"]],
        n_variants: int = 1,
        seed: int | None = None,
    ) -> None: ...
    def set_mix(
        self,
        gain_db: float | None = None,
        pan: float | None = None,
        mute: bool | None = None,
        solo: bool | None = None,
    ) -> None: ...
    def set_effects(self, chain: list[EffectSpec]) -> None: ...
    def set_doubling(
        self,
        layers: int | None = None,
        spacing: float | None = None,
        detune_cents: float | None = None,
        jitter_ms: float | None = None,
        timbre: float | None = None,
        seed: int | None = None,
    ) -> None: ...

class Note:
    @property
    def id(self) -> int: ...
    lyric: str
    @property
    def pitch_cents(self) -> float: ...
    @property
    def start(self) -> int: ...
    @property
    def length(self) -> int: ...
    @property
    def is_phrase_end(self) -> bool: ...
    def curve(self, param: str) -> Curve: ...
    def vibrato(
        self,
        depth_cents: float,
        rate_hz: float,
        start: float = 0.25,
        fade_in: float = 0.2,
        fade_out: float = 0.2,
        drift: float = 0.5,
    ) -> None: ...
    def move_by(self, dt: int = 0, dcents: float = 0.0) -> None: ...
    def remove(self) -> None: ...
    def resize(self, length: int) -> None: ...
    def set_phonemes(
        self, phonemes: list[str] | None, lengths_ms: list[float | None] | None = None
    ) -> None: ...
    def portamento(
        self,
        length_ms: float | None = None,
        overshoot_cents: float = 0.0,
        preparation_cents: float = 0.0,
        before: float = 0.6,
    ) -> None: ...

class Curve:
    def ramp(self, to: float, over: str = "all", from_: float = 0.0) -> None: ...
    def set(self, value: float) -> None: ...

class NoteMetric:
    id: int
    lyric: str
    pitch_error_mean: float
    pitch_error_p95: float
    pitch_error_max: float
    pitch_bias: float
    onset_error_ms: float
    voiced_ratio: float

class Report:
    @property
    def notes(self) -> list[NoteMetric]: ...
    @property
    def audio_path(self) -> str: ...
    @property
    def audio_hash(self) -> str: ...
    @property
    def render_id(self) -> str: ...
    def to_json(self) -> str: ...
    def summary(self) -> str: ...

def open(path: str | PathLike[str]) -> Project: ...
def new(title: str = "") -> Project: ...
def import_file(path: str | PathLike[str]) -> Project: ...
